---
import Layout from '../layouts/Layout.astro';
import { ComoUsarFuradeira } from '../components/ComoUsarFuradeira';
---

<Layout 
  title="Como Usar Furadeira com Segurança Passo a Passo Completo"
  description="Aprenda a usar sua furadeira com segurança e precisão. Confira nosso guia definitivo e descubra como realizar perfurações perfeitas em qualquer material."
>
  <main>
    {/* client:load é crucial para componentes educativos que mostram anatomia da ferramenta e segurança */}
    <ComoUsarFuradeira client:load />
  </main>
</Layout>

<style>
  main {
    margin: 0;
    padding: 0;
    width: 100%;
  }
</style>