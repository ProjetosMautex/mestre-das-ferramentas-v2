---
import Layout from '../layouts/Layout.astro';
import { OQueEBrocaEscalonada } from '../components/OQueEBrocaEscalonada';
---

<Layout 
  title="O Que é Broca Escalonada e Como Usar - Mestre das Ferramentas"
  description="Cansado de trocar de broca a cada furo? Descubra o que é a broca escalonada, como furar chapas com precisão e as dicas profissionais para não queimar a ferramenta!"
>
  <main>
    {/* A diretiva client:load é necessária para que os elementos interativos do React funcionem no Astro */}
    <OQueEBrocaEscalonada client:idle />
  </main>
</Layout>

<style>
  main {
    margin: 0;
    padding: 0;
    width: 100%;
  }
</style>
